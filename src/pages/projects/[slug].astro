---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { GraphQLClient, gql } from "graphql-request";
import { Image } from "astro:assets";
import { marked } from "marked";

type Project = {
  name: string;
  slug: string;
  skills: {
    name: string;
    slug: string;
  }[];
  description: {
    content: string;
  };
  link: string;
  poster: {
    url: string;
  };
};

type ProjectsResponse = {
  projects: Project[];
};

type Skill = {
  name: string;
  slug: string;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const client = new GraphQLClient(import.meta.env.ASTRO_HYGRAPH_ENDPOINT);

  const query = `
    query Projects {
      projects {
        name
        slug
        skills {
          name
          slug
        }
        description {
          content
        }
        link
        poster {
          url
        }
      }
    }
  `;

  const data: ProjectsResponse = await client.request(query);

  return data.projects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
};

const { project }: any = Astro.props;
const { name, poster, skills, description } = project;

const { content } = description;

const html = marked.parse(content);
---

<Layout title={name}>
  <main class="p-4 flex flex-col flex-1 items-stretch justify-start w-full">
    <article class="flex flex-col gap-10">
      <div>
        <h1
          class="text-4xl dark:text-white text-neutral-20 font-bold mb-4">
          {name}
        </h1>
        <div
          class="flex gap-1 *:rounded-xl *:bg-neutral-20 *:text-white *:px-2 *:py-1">
          {
            skills.map((skill: Skill) => {
              return (
                <span class="text-sm font-semibold dark:bg-secondary">
                  {skill.name}
                </span>
              );
            })
          }
        </div>
      </div>

      <section
        class="flex flex-col w-full justify-center items-center p-2 rounded-sm">
        <article
          class="w-3/5 flex-1 bg-white dark:bg-neutral flex flex-col gap-5 rounded-sm size-100">
          <Image
            src={poster.url}
            alt={`Imagen proyecto ${name}`}
            class="rounded-sm hover:shadow-xl hover:scale-102 dark:hover:shadow-secondary hover:shadow-neutral-20 transition-all duration-300 ease-in-out"
            inferSize
          />
          <div
            set:html={html}
            class="p-5 prose text-tertiary-20 dark:text-white prose-strong:text-tertiary dark:prose-strong:text-secondary"
          />
        </article>
      </section>
    </article>
  </main>
</Layout>
