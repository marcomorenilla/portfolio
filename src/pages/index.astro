---
import ContentBoldParser from "../components/ContentBoldParser.astro";
import Layout from "../layouts/Layout.astro";
import { GraphQLClient } from "graphql-request";

const client = new GraphQLClient(import.meta.env.ASTRO_HYGRAPH_ENDPOINT);

type Profiles = {
  profiles: Profile[];
};

type Profile = {
  github: string;
  id: string;
  linkedin: string;
  name: string;
};

const { profiles }: Profiles = await client.request(`
 query Profile{ 
  profiles {
    github
    id
    linkedin
    name
  }
 }
`);

const { github, linkedin, name } = profiles[0];
---

<Layout title="Portfolio mmorenilla.dev">
  <main class="h-full p-4 w-full flex justify-center items-center">
    <section class="prose md:prose-xl dark:prose-invert">
      <h1 class="text-xl md:text-5xl font-black">
        {name}
      </h1>
    </section>
  </main>
</Layout>
