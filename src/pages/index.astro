---
import Layout from "../layouts/Layout.astro";
import { GraphQLClient } from "graphql-request";
import { Icon } from "astro-icon/components";

const client = new GraphQLClient(import.meta.env.ASTRO_HYGRAPH_ENDPOINT);

type ProfilesIndex = {
  profiles: {
    id: string;
    name: string;
    subtitle: string;
    cv: {
      url: string;
    };
  }[];
};

const { profiles }: ProfilesIndex = await client.request(`
 query Profile{ 
  profiles {
    id
    name
    subtitle
    cv{
      url
    }
  }
 }
`);

const { subtitle, name, cv } = profiles[0];
const { url } = cv;
---

<Layout title="Portfolio mmorenilla.dev">
  <main class="p-4 w-full flex flex-1 justify-center items-center">
    <section class="flex flex-col place-items-center gap-4">
      <h1
        class="text-4xl text-center md:text-5xl dark:text-white text-transparent bg-linear-to-r from-tertiary-20 via-tertiary to-tertiary-20 bg-clip-text font-black">
        {name}
      </h1>
      <p
        class="text-center text-tertiary-20 font-semibold dark:text-white text-lg">
        {subtitle}
      </p>
      <a
        href={url}
        target="_blank"
        rel="noreferrer"
        class="flex gap-2 items-center justify-center cursor-pointer dark:bg-secondary text-white bg-tertiary-20 rounded-sm p-2 font-semibold hover:scale-110 transition-all duration-300 ease-in-out"
        ><Icon name="material-symbols-light:picture-as-pdf" /> Ver cv</a
      >
    </section>
  </main>
</Layout>
