---
import { Icon } from "astro-icon/components";
---

<dialog
  class="animate-opacity w-full h-full max-h-none max-w-none min-h-screen bg-transparent">
  <section class="w-full h-full flex justify-center items-center px-2">
    <article class="rounded-xl flex justify-center items-center gap-2">
      <div
        class="flex bg-white justify-center items-center gap-2 p-2 success container">
        <Icon class="size-8 icon-success" name="mdi:sticker-emoji" />
        <Icon
          class="size-8 icon-error hidden"
          name="mdi:sticker-remove-outline"
        />
        <h2 class="font-bold p-2">Mensaje enviado con éxito</h2>
      </div>
    </article>
  </section>
</dialog>

<script>
  import { $state } from "../store/dialog";

  const dialog = document.querySelector("dialog");
  const message = document.querySelector("h2");
  const container = document.querySelector(".container");
  const iconSuccess = document.querySelector(".icon-success");
  const iconError = document.querySelector(".icon-error");
  $state.subscribe((state) => {
    if (state.isOpen) {
      dialog!!.showModal();
      if (state.type === "success") {
        container!!.classList.remove("failure");
        container!!.classList.add("success");
        iconError!!.classList.add("hidden");
        iconSuccess!!.classList.remove("hidden");
      } else {
        container!!.classList.remove("success");
        container!!.classList.add("failure");
        iconError!!.classList.remove("hidden");
        iconSuccess!!.classList.add("hidden");
      }

      message!!.textContent = state.message;
    } else {
      dialog!!.close();
    }
  });
</script>
