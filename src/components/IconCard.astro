---
import { Icon } from "astro-icon/components";
const { skill } = Astro.props;
---

<div
  class="w-full aspect-2/3 shadow hover:scale-105 transition-all duration-300 ease-in-out shadow-tertiary-20 dark:shadow-secondary flex flex-col justify-between items-center rounded-sm border border-tertiary-20 bg-white dark:bg-neutral">
  <div
    class="flex flex-1 shrink-0 justify-center items-center dark:bg-radial-[at_50%_50%] from-white to-secondary-20 w-full">
    <Icon class="size-10" name={"devicon:" + skill.slug} />
  </div>

  <div
    class="w-full px-2 py-2 border-t border-tertiary-20 bg-neutral-50/50 dark:bg-neutral-900/30">
    <p
      class="dark:text-white w-full text-center font-semibold text-sm text-tertiary-20">
      {skill.name}
    </p>
  </div>
</div>
