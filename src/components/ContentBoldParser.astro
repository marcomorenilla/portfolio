---
const { content } = Astro.props;
---

<>
  {
    content.split("\n").map((paragraph: string) => {
      if (!paragraph.trim()) return null;

      return (
        <p class="font-bold text-tertiary-20 dark:text-white">
          {paragraph.split(" ").map((word: string) => {
            if (word.includes("**")) {
              const cleanWord = word.replace(/\*\*/g, " ");
              return <span class="text-tertiary dark:text-secondary ">{cleanWord} </span>;
            } else {
              return word + " ";
            }
          })}
        </p>
      );
    })
  }
</>
