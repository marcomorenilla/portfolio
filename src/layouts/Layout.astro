---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="generator" content={Astro.generator} />
    <!-- SEO Estándar -->
    <title>{title}</title>
    <meta
      name="description"
      content="Portfolio profesional de Marco Antonio Morenilla hecho con Astro e Hygraph"
    />
    <meta
      name="keywords"
      content="Marco Antonio Morenilla Alonso, desarrollo web, frontend, backend, portfolio, Astro, react, programador, mmorenilla"
    />
    <meta name="author" content="Marco Antonio Morenilla Alonso" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://dev.mmorenilla.com" />

    <!-- Favicon (El logo de la pestaña <m/>) -->
    <link rel="icon" type="image/png" href="/mmorenilla-logo.png" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dev.mmorenilla.com" />
    <meta property="og:title" content="Marco Antonio Morenilla Alonso" />
    <meta
      property="og:description"
      content="Portfolio profesional de Marco Antonio Morenilla hecho con Astro e Hygraph"
    />
    <meta
      property="og:image"
      content="https://dev.mmorenilla.com/mmorenilla-logo.png"
    />
    <meta
      property="og:site_name"
      content="Portfolio de Marco Antonio Morenilla"
    />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://dev.mmorenilla.com" />
    <meta name="twitter:title" content="Marco Antonio Morenilla Alonso" />
    <meta
      name="twitter:description"
      content="Portfolio profesional de Marco Antonio Morenilla hecho con Astro e Hygraph"
    />
    <meta
      name="twitter:image"
      content="https://dev.mmorenilla.com/mmorenilla-logo.png"
    />
    <ClientRouter />
  </head>
  <body
    class="bg-white transition-colors ease-in-out duration-700 dark:bg-neutral">
    <div
      id="small-dots-container"
      class="relative flex flex-col min-h-screen dark:bg-dots-small-dark bg-dots-small bg-size-[20px_20px]">
      <div
        id="big-dots-layer"
        class="absolute inset-0 dark:bg-dots-large-dark bg-dots-large bg-size-[20px_20px] pointer-events-none transition-opacity duration-300 opacity-0">
      </div>
      <div class="z-10 flex grow flex-col">
        <Navbar />
        <div
          transition:animate="slide"
          class="flex flex-1 min-h-0 grow flex-col">
          <slot />
        </div>
        <Footer class="shrink-0" />
      </div>
    </div>

    <script>
      document.addEventListener("astro:page-load", () => {
        const container = document.getElementById("small-dots-container");
        const layer = document.getElementById("big-dots-layer");

        container?.addEventListener("mousemove", (e) => {
          const rect = container.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          layer!!.style.opacity = "1";

          const maskString = `radial-gradient(circle 100px at ${x}px ${y}px, black , transparent )`;

          layer!!.style.maskImage = maskString;
        });

        container?.addEventListener("mouseleave", () => {
          layer!!.style.opacity = "0";
        });
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
